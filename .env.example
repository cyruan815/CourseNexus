DATABASE_URL=sqlite:///./course_nexus.db
APP_ENV=development
SECRET_KEY=replace-with-local-dev-secret
FILE_STORAGE_PATH=./uploads

# Backend-only secrets. Do not expose these through VITE_ variables.
OPENAI_API_KEY=
MODEL_API_BASE_URL=

# Frontend public runtime config. VITE_ variables are bundled into the browser.
VITE_API_BASE_URL=http://localhost:8000/api/v1
