# ==================== 应用基础配置 ====================
# APP_ENV 仅支持 development、test、production。
# production 必须使用至少 32 位的非默认 SECRET_KEY，并配置所有已开放模型能力。
DATABASE_URL=sqlite:///./course_nexus.db
APP_ENV=development
ENABLE_MOCK_MODEL_PROVIDER=false
SECRET_KEY=replace-with-local-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FILE_STORAGE_PATH=./uploads
MAX_UPLOAD_FILE_SIZE_BYTES=52428800
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=20
SLOW_REQUEST_MS=3000
# 允许浏览器直接访问后端的前端来源，多个来源用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==================== Embedding 向量模型 ====================
# 用于资料切片向量化、Chroma 索引和语义检索，可接入任意 OpenAI 兼容服务。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ==================== 课程智能体问答模型 ====================
# 用于基于课程资料检索结果生成带引用的问答回复。
COURSE_QA_API_KEY=
COURSE_QA_BASE_URL=
COURSE_QA_MODEL=gpt-5.4-mini

# ==================== Quiz 测验生成模型 ====================
# 用于根据所选资料生成选择题、判断题等测验内容。
QUIZ_API_KEY=
QUIZ_BASE_URL=
QUIZ_MODEL=gpt-5.4-mini

# ==================== Flashcard 闪卡生成模型 ====================
# 用于根据所选资料生成正反面学习闪卡。
FLASHCARD_API_KEY=
FLASHCARD_BASE_URL=
FLASHCARD_MODEL=gpt-5.4-mini

# ==================== Mindmap 思维导图生成模型 ====================
# 用于提炼资料结构并生成思维导图节点关系。
MINDMAP_API_KEY=
MINDMAP_BASE_URL=
MINDMAP_MODEL=gpt-5.4-mini

# ==================== Outline 大纲生成模型 ====================
# 用于根据所选资料生成分层学习大纲。
OUTLINE_API_KEY=
OUTLINE_BASE_URL=
OUTLINE_MODEL=gpt-5.4-mini

# ==================== Knowledge List 知识清单模型 ====================
# 用于从所选资料中提炼知识点、重点和学习检查清单。
KNOWLEDGE_LIST_API_KEY=
KNOWLEDGE_LIST_BASE_URL=
KNOWLEDGE_LIST_MODEL=gpt-5.4-mini

# ==================== 学习计划输入解析模型 ====================
# 用于把自然语言目标、日期和约束解析为结构化计划参数。
STUDY_PLAN_PARSER_API_KEY=
STUDY_PLAN_PARSER_BASE_URL=
STUDY_PLAN_PARSER_MODEL=gpt-5.4-mini

# ==================== 学前诊断题生成模型 ====================
# 用于根据学习目标、已确认配置和资料摘录生成 3 道学前诊断 topic 题。
STUDY_PLAN_DIAGNOSTIC_API_KEY=
STUDY_PLAN_DIAGNOSTIC_BASE_URL=
STUDY_PLAN_DIAGNOSTIC_MODEL=gpt-5.4-mini

# ==================== 学习计划生成模型 ====================
# 用于根据目标、资料和时间约束生成阶段与任务安排。
STUDY_PLAN_GENERATOR_API_KEY=
STUDY_PLAN_GENERATOR_BASE_URL=https://api.deepseek.com
STUDY_PLAN_GENERATOR_MODEL=deepseek-v4-pro
# API 风格：auto 会按 BASE_URL 选择 Responses（OpenAI）或 Chat Completions（DeepSeek）。
STUDY_PLAN_GENERATOR_API_STYLE=auto

# ==================== 学习计划 map 模型 ====================
# 用于把资料 batch 提取为知识单元；API key 和 base URL 留空时复用上面的 generator 配置。
STUDY_PLAN_MAP_API_KEY=
STUDY_PLAN_MAP_BASE_URL=https://api.deepseek.com
STUDY_PLAN_MAP_MODEL=deepseek-v4-flash
# 可选 auto、responses 或 chat；显式值只影响 map，不改变 generator。
STUDY_PLAN_MAP_API_STYLE=auto

# ==================== 学习讲义生成模型 ====================
# 用于计划学习模式中的任务讲义和学习内容生成。
HANDOUT_API_KEY=
HANDOUT_BASE_URL=
HANDOUT_MODEL=gpt-5.4-mini

# ==================== 学习任务测试模型 ====================
# 用于计划任务完成后的掌握度测试和结果反馈生成。
TASK_TEST_API_KEY=
TASK_TEST_BASE_URL=
TASK_TEST_MODEL=gpt-5.4-mini

# ==================== RAG 检索与索引配置 ====================
# 配置本地 Chroma 存储、检索数量以及资料切片和批处理上限。
CHROMA_PERSIST_PATH=./data/chroma
CHROMA_COLLECTION=course_nexus_material_chunks
RAG_SIMILARITY_TOP_K=8
RAG_CHUNK_MAX_TOKENS=800
MATERIAL_BATCH_MAX_TOKENS=12000
MATERIAL_CONTEXT_MAX_TOKENS=120000
# map 阶段模型调用并发度，范围 1..5。
STUDY_PLAN_MAP_CONCURRENCY=1
MARKMAP_NODE_COMMAND=node
MARKMAP_TRANSFORM_TIMEOUT_SECONDS=15

# ==================== 前端公开配置 ====================
# 浏览器访问后端的服务根地址；不要在 VITE_ 变量中放置任何模型密钥。
VITE_API_BASE_URL=http://localhost:8000
